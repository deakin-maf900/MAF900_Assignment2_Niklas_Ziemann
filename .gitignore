# Data that is NOT committed
#   WRDS extracts are licensed and stay on the machine that downloaded them (script 05 re-creates them)
#   the ASX directory is a daily snapshot; the one the report used (3 September 2026) is committed so a
#   re-run reproduces the same match, later downloads are not
#   processed files are rebuilt by the scripts
data/raw/wrds/*
data/raw/asx/*
data/processed/*
!data/raw/wrds/.gitkeep
!data/raw/asx/.gitkeep
!data/raw/asx/asx_directory_2026-09-03.csv
!data/processed/.gitkeep

# Data that IS committed (so nothing above matches it):
#   data/raw/nger/            the 17 public register files, CC BY 4.0, about 400 KB (script 01 skips files already on disk)
#   data/raw/rba/             the two public RBA exchange rate files (script 03b)
#   data/hand_collected/      the CSV transcribed by hand from the firms' own reports; no script can recreate it

# Output is regenerated by the scripts
output/tables/*
output/figures/*
!output/tables/.gitkeep
!output/figures/.gitkeep
output/log_*.txt
output/_old/
Rplots.pdf

# Local configuration (user name and paths on this machine), see README; config_example.csv is the template
config.csv

# Tables rendered by modelsummary
tinytable_assets/

# RStudio and R session files
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# renv keeps its own .gitignore inside renv/ (the project library is not committed; renv.lock is)
